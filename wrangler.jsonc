{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "truesight",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./website",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "r2_buckets": [
    {
      "binding": "DOWNLOADS",
      "bucket_name": "truesight-downloads"
    }
  ],
  "observability": {
    "enabled": true
  }
}
